{
  "name": "magic-garden-desktop",
  "version": "0.26.31",
  "description": "Magic Garden Desktop — standalone desktop client with QPM-GR mod integration",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:ci": "electron-builder --win nsis --x64 --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AchinthaMP/Magic-garden-Desktop.git"
  },
  "keywords": [
    "magic-garden",
    "qpm",
    "desktop",
    "electron"
  ],
  "author": "AchinthaMP",
  "license": "MIT",
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "appId": "com.magicgarden.desktop",
    "productName": "Magic Garden",
    "asar": true,
    "compression": "normal",
    "files": [
      "main.js",
      "package.json",
      "qpm/**",
      "assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "AchinthaMP",
      "repo": "Magic-garden-Desktop"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Magic-Garden-Setup-${version}.exe",
      "installerIcon": null,
      "uninstallerIcon": null,
      "installerHeaderIcon": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Magic Garden"
    }
  }
}
